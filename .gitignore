# ---------------------------------------------------------------------------
# 构建产物：可由源码重新生成，不入库
# ---------------------------------------------------------------------------
build/
dist/

# 由 packaging/build.py 每次构建时重写，正文里含构建机的绝对路径
packaging/luobobox.iss
packaging/version_info.txt

# ---------------------------------------------------------------------------
# 测试运行残留
# ---------------------------------------------------------------------------
tests/_shots/
tests/_shots*/
tests/_selftest/
tests/_exerun/
tests/_envsetup/
*.log

# 数据目录迁移指针：源码运行时会落在仓库根目录（指针必须在程序目录旁边），
# 内容是本机绝对路径，绝不能入库。
datadir.txt

# 仓库根目录下一次性的排查 / 发版脚本（_verify_*.py、_shot_*.py、_rel.py …）。
# 只锚根目录：包内 legit 的 __init__.py / _source.json 不受影响。
# ★ 这条是被一次 `git add -A` 误提交逼出来的 —— 临时脚本永远不该进版本库。
/_*.py
/_*.html
/_*.png
/_*.txt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
